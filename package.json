{
  "name": "sky-war-shooter-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "check": "tsc --noEmit && vite build --logLevel error && vitest run"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "license": "GPL-2.0-or-later",
  "description": "WWII B-17 gunner and P-51 escort combat game for the browser (Three.js)"
}
