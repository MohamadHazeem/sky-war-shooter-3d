{
  "name": "sky-war-shooter-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "check": "tsc --noEmit && vite build --logLevel error && vitest run",
    "models:compress": "node tools/compress_models.mjs",
    "icons": "node tools/make_icons.mjs",
    "size": "node tools/size_report.mjs dist"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "license": "GPL-2.0-or-later",
  "description": "WWII B-17 gunner and P-51 escort combat game for the browser (Three.js)"
}
