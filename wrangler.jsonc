{
  // Cloudflare static hosting for the built game (npm run build -> dist/)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sky-war-shooter-3d",
  "compatibility_date": "2026-10-06",
  "main": "worker/index.ts",
  "assets": { "binding": "ASSETS", "run_worker_first": ["/api/turn"], "directory": "./dist", "not_found_handling": "single-page-application" }
}
