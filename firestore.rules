rules_version = '2';

// Sky War Shooter 3D — online leaderboard.
// - Anyone can read scores.
// - Signed-in (anonymous) players can only append entries: no edits, no deletes.
// - Every entry is validated (fields, types, ranges, plausibility) and must be written in the
//   same batch as the player's 'limits' stamp, which allows one entry per 20 seconds.
// Anonymous gameplay stats (src/net/Analytics.ts): one append-only summary per mission in
// 'analytics_events', no personal data, never readable by clients, rate-limited through
// 'analytics_limits' (one write per 10 seconds per player).
service cloud.firestore {
  match /databases/{database}/documents {

    function intIn(v, lo, hi) { return v is int && v >= lo && v <= hi; }
    function optInt(m, k, hi) { return !(k in m) || intIn(m[k], 0, hi); }
    function shortStr(v, max) { return v is string && v.size() <= max; }

    function validMissionStats(d) {
      return d.keys().hasAll(['v', 'event', 'createdAt', 'mission', 'mode', 'role', 'outcome', 'success', 'duration', 'kills', 'accuracy', 'bombersLost', 'rounds', 'shots', 'deaths', 'score', 'seatSwitches', 'seats', 'abilities', 'perks', 'settings', 'device', 'fpsAvg', 'fpsP10', 'fpsBucket', 'dev'])
        && d.keys().hasOnly(['v', 'event', 'createdAt', 'mission', 'mode', 'role', 'outcome', 'success', 'duration', 'kills', 'accuracy', 'bombersLost', 'rounds', 'shots', 'deaths', 'score', 'seatSwitches', 'seats', 'abilities', 'perks', 'settings', 'device', 'fpsAvg', 'fpsP10', 'fpsBucket', 'dev'])
        && d.v == 1 && d.event == 'mission' && d.createdAt == request.time
        && shortStr(d.mission, 40) && d.mission.matches('^[a-z0-9-]{1,40}$')
        && d.mode in ['campaign', 'survival', 'acehunt', 'timeattack', 'daily', 'tutorial', 'other']
        && d.role in ['gunner', 'pilot']
        && d.outcome in ['success', 'fail', 'aborted'] && d.success is bool
        && intIn(d.duration, 0, 36000) && intIn(d.kills, 0, 5000)
        && (d.accuracy is int || d.accuracy is float) && d.accuracy >= 0 && d.accuracy <= 1
        && intIn(d.bombersLost, 0, 100) && intIn(d.rounds, 0, 500) && intIn(d.shots, 0, 1000000)
        && intIn(d.deaths, 0, 1) && intIn(d.score, 0, 5000000) && intIn(d.seatSwitches, 0, 10000)
        && d.seats is map && d.seats.keys().hasOnly(['waistL', 'waistR', 'top', 'ball', 'tail'])
        && optInt(d.seats, 'waistL', 36000) && optInt(d.seats, 'waistR', 36000) && optInt(d.seats, 'top', 36000)
        && optInt(d.seats, 'ball', 36000) && optInt(d.seats, 'tail', 36000)
        && d.abilities is map && d.abilities.keys().hasOnly(['mustangs', 'overdrive', 'focus'])
        && optInt(d.abilities, 'mustangs', 999) && optInt(d.abilities, 'overdrive', 999) && optInt(d.abilities, 'focus', 999)
        && shortStr(d.perks, 600) && d.perks.matches('^[a-z0-9_,]*$')
        && d.settings is map
        && d.settings.keys().hasOnly(['quality', 'aimAssist', 'difficulty', 'flightMode', 'language', 'touch', 'gamepad'])
        && d.settings.quality in ['low', 'medium', 'high']
        && d.settings.aimAssist in ['off', 'low', 'high']
        && d.settings.difficulty in ['recruit', 'veteran', 'ace']
        && d.settings.flightMode in ['mouseAim', 'direct']
        && shortStr(d.settings.language, 2) && d.settings.language.matches('^[a-z]{2}$')
        && d.settings.touch is bool && d.settings.gamepad is bool
        && d.device is map && d.device.keys().hasOnly(['screen', 'touch', 'dpr'])
        && d.device.screen in ['phone', 'tablet', 'laptop', 'desktop', 'large']
        && d.device.touch is bool
        && (d.device.dpr is int || d.device.dpr is float) && d.device.dpr >= 0 && d.device.dpr <= 4
        && intIn(d.fpsAvg, 0, 500) && intIn(d.fpsP10, 0, 500)
        && d.fpsBucket in ['<20', '20-30', '30-45', '45-58', '58+']
        && d.dev is bool;
    }

    match /limits/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && (resource == null || resource.data.last < request.time - duration.value(20, 's'));
      allow delete: if false;
    }

    // cloud saves: the 20-character random document id is the secret transfer code
    match /saves/{code} {
      allow get: if request.auth != null && code.size() == 20;
      allow list, delete: if false;
      allow create, update: if request.auth != null && code.size() == 20
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'v'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.updatedAt == request.time && request.resource.data.v == 1;
    }

    // Online co-op signalling (src/net/Signal.ts). A room is a 6-character join code holding the
    // host's WebRTC offer and, once joined, the guest's answer; ICE candidates trickle through
    // the hostIce / guestIce subcollections. Signed-in players only, fixed shapes and sizes,
    // one guest per room, usable for 2 hours from creation (after that nothing can read or join
    // it; expiresAt is ready for a Firestore TTL policy, which needs billing enabled), only the
    // creator may delete (the host does once connected). Rooms cannot be listed.
    match /coop_rooms/{code} {
      function codeOk() { return code.matches('^[A-HJ-NP-Z2-9]{6}$'); }
      function live(r) { return r.createdAt + duration.value(2, 'h') > request.time; }
      function sdpOk(d, kind) {
        return d is map && d.keys().hasOnly(['type', 'sdp']) && d.type == kind
          && d.sdp is string && d.sdp.size() > 0 && d.sdp.size() < 16000;
      }
      function expiryOk(t) {
        return t is timestamp && t > request.time + duration.value(90, 'm') && t < request.time + duration.value(150, 'm');
      }

      allow get: if request.auth != null && codeOk() && (resource == null || live(resource.data));
      allow list: if false;
      allow create: if request.auth != null && codeOk()
        && request.resource.data.keys().hasOnly(['host', 'offer', 'createdAt', 'expiresAt', 'v'])
        && request.resource.data.keys().hasAll(['host', 'offer', 'createdAt', 'expiresAt', 'v'])
        && request.resource.data.host == request.auth.uid
        && sdpOk(request.resource.data.offer, 'offer')
        && request.resource.data.createdAt == request.time
        && expiryOk(request.resource.data.expiresAt)
        && request.resource.data.v == 1;
      // the guest claims the single free seat by writing its answer, once
      allow update: if request.auth != null && live(resource.data)
        && !('guest' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['guest', 'answer'])
        && request.resource.data.keys().hasAll(['guest', 'answer'])
        && request.resource.data.guest == request.auth.uid
        && sdpOk(request.resource.data.answer, 'answer');
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;

      match /{side}/{cid} {
        function room() { return get(/databases/$(database)/documents/coop_rooms/$(code)).data; }
        function member(r) { return request.auth.uid == r.host || ('guest' in r && request.auth.uid == r.guest); }
        allow read: if request.auth != null && side in ['hostIce', 'guestIce']
          && exists(/databases/$(database)/documents/coop_rooms/$(code)) && live(room()) && member(room());
        allow create: if request.auth != null && side in ['hostIce', 'guestIce']
          && exists(/databases/$(database)/documents/coop_rooms/$(code)) && live(room())
          && (side == 'hostIce' ? request.auth.uid == room().host : ('guest' in room() && request.auth.uid == room().guest))
          && request.resource.data.keys().hasOnly(['c', 'mid', 'idx', 'expiresAt'])
          && request.resource.data.keys().hasAll(['c', 'mid', 'idx', 'expiresAt'])
          && request.resource.data.c is string && request.resource.data.c.size() > 0 && request.resource.data.c.size() <= 1000
          && request.resource.data.mid is string && request.resource.data.mid.size() <= 32
          && request.resource.data.idx is int && request.resource.data.idx >= 0 && request.resource.data.idx < 16
          && expiryOk(request.resource.data.expiresAt);
        allow update: if false;
        allow delete: if request.auth != null && side in ['hostIce', 'guestIce']
          && exists(/databases/$(database)/documents/coop_rooms/$(code)) && request.auth.uid == room().host;
      }
    }

    // Public scores use an opaque boardId, never the six-character invitation code.
    // Phase 6: private squadrons. The profile is the authority; localStorage is only a mirror.
    function squadCode(code) { return code is string && code.matches('^[A-HJ-NP-Z2-9]{6}$'); }
    function squadMember(code) {
      return request.auth != null && exists(/databases/$(database)/documents/squadrons/$(code)/members/$(request.auth.uid));
    }
    function profileAfter() { return getAfter(/databases/$(database)/documents/squadronProfiles/$(request.auth.uid)).data; }
    function squadScore(d) {
      return !('squadron' in d) || (d.squadron is string && d.squadron.matches('^[a-f0-9]{32}$')
        && squadMember(get(/databases/$(database)/documents/squadronProfiles/$(request.auth.uid)).data.code)
        && get(/databases/$(database)/documents/squadrons/$(get(/databases/$(database)/documents/squadronProfiles/$(request.auth.uid)).data.code)).data.boardId == d.squadron
        && d.name == get(/databases/$(database)/documents/squadronProfiles/$(request.auth.uid)).data.callsign);
    }
    match /squadronProfiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['callsign', 'code'])
        && request.resource.data.callsign is string && request.resource.data.callsign.size() >= 2 && request.resource.data.callsign.size() <= 16
        && request.resource.data.callsign.matches("^[\\p{L}\\p{N} .'-]{2,16}$")
        && request.resource.data.code == '';
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code'])
        && ((resource.data.code == '' && squadCode(request.resource.data.code)
          && existsAfter(/databases/$(database)/documents/squadrons/$(request.resource.data.code)/members/$(uid)))
          || (request.resource.data.code == '' && squadCode(resource.data.code)
          && !existsAfter(/databases/$(database)/documents/squadrons/$(resource.data.code)/members/$(uid))));
      allow delete: if false;
    }
    match /squadrons/{code} {
      function memberPath() { return /databases/$(database)/documents/squadrons/$(code)/members/$(request.auth.uid); }
      function joining() { return !exists(memberPath()) && existsAfter(memberPath()) && profileAfter().code == code; }
      function leaving() { return exists(memberPath()) && !existsAfter(memberPath()) && profileAfter().code == ''; }
      // A code grants a metadata lookup and the right to join, never directory enumeration.
      allow get: if request.auth != null && squadCode(code);
      allow list, delete: if false;
      allow create: if request.auth != null && squadCode(code)
        && request.resource.data.keys().hasOnly(['name', 'boardId', 'createdAt', 'memberCount'])
        && request.resource.data.boardId is string && request.resource.data.boardId.matches('^[a-f0-9]{32}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.name.matches('^(Silver|Golden|Brave|Flying|Desert|Midnight) (Falcons|Eagles|Hawks|Wings|Stars|Owls)$')
        && request.resource.data.createdAt == request.time && request.resource.data.memberCount == 1 && joining();
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
        && intIn(request.resource.data.memberCount, 0, 64)
        && ((joining() && request.resource.data.memberCount == resource.data.memberCount + 1)
          || (leaving() && request.resource.data.memberCount == resource.data.memberCount - 1));
      match /members/{uid} {
        allow read: if squadMember(code);
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['callsign', 'joinedAt'])
          && request.resource.data.callsign == profileAfter().callsign && profileAfter().code == code
          && get(/databases/$(database)/documents/squadronProfiles/$(uid)).data.code == ''
          && request.resource.data.joinedAt == request.time
          && getAfter(/databases/$(database)/documents/squadrons/$(code)).data.memberCount ==
            (exists(/databases/$(database)/documents/squadrons/$(code)) ? get(/databases/$(database)/documents/squadrons/$(code)).data.memberCount + 1 : 1);
        allow update: if false;
        allow delete: if request.auth != null && request.auth.uid == uid && profileAfter().code == ''
          && getAfter(/databases/$(database)/documents/squadrons/$(code)).data.memberCount == get(/databases/$(database)/documents/squadrons/$(code)).data.memberCount - 1;
      }
      match /bests/{id} {
        allow read: if squadMember(code);
        allow create, update: if squadMember(code)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'mode', 'score', 'kills', 'rounds', 'createdAt', 'v', 'squadron', 'scoreId'])
          && request.resource.data.scoreId is string && request.resource.data.scoreId.size() <= 40
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.squadron == get(/databases/$(database)/documents/squadrons/$(code)).data.boardId
          && id == request.auth.uid + '_' + request.resource.data.mode
          && request.resource.data.createdAt == request.time
          && request.resource.data.diff(getAfter(/databases/$(database)/documents/scores/$(request.resource.data.scoreId)).data).affectedKeys().hasOnly(['scoreId'])
          && (resource == null || request.resource.data.score > resource.data.score);
        allow delete: if false;
      }
      match /activity/{uid} {
        allow read: if squadMember(code);
        allow create, update: if request.auth != null && request.auth.uid == uid
          && existsAfter(/databases/$(database)/documents/squadrons/$(code)/members/$(uid))
          && profileAfter().code == code
          && request.resource.data.keys().hasOnly(['name', 'kind', 'createdAt'])
          && request.resource.data.name == profileAfter().callsign && request.resource.data.createdAt == request.time
          && ((request.resource.data.kind == 'joined' && !exists(/databases/$(database)/documents/squadrons/$(code)/members/$(uid)))
            || (request.resource.data.kind == 'experte' && squadMember(code)
              && (resource == null || resource.data.createdAt < request.time - duration.value(20, 's'))));
        allow delete: if false;
      }
    }

    match /scores/{id} {
      allow read: if true;
      allow update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'name', 'mode', 'score', 'kills', 'rounds', 'createdAt', 'v', 'squadron'])
        && squadScore(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= (request.resource.data.mode == 'coop-gunner' ? 89 : request.resource.data.mode == 'coop-pilot' ? 43 : 20)
        && request.resource.data.mode is string && request.resource.data.mode.size() <= 40
        && request.resource.data.mode.matches('^(coop-(gunner|pilot)|survival-(gunner|pilot|sea|aa)|campaign-m[0-9]{1,2}|daily-(gunner|pilot)-[0-9]{8}|weekly-(gunner|pilot)-[0-9]{6}|(acehunt|timeattack|raid|night|strafe)-(gunner|pilot))$')
        && request.resource.data.score is int && request.resource.data.score >= 0 && request.resource.data.score <= 5000000
        && request.resource.data.kills is int && request.resource.data.kills >= 0 && request.resource.data.kills <= 5000
        && request.resource.data.rounds is int && request.resource.data.rounds >= 0 && request.resource.data.rounds <= 500
        // plausibility: points per kill are capped (bosses and multipliers included)
        && request.resource.data.score <= request.resource.data.kills * 4000 + request.resource.data.rounds * 3000 + 5000
        && request.resource.data.createdAt == request.time
        && request.resource.data.v == 1
        && getAfter(/databases/$(database)/documents/limits/$(request.auth.uid)).data.last == request.time;
    }

    // ---- anonymous gameplay stats ----
    match /analytics_limits/{uid} {
      allow read, delete: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last == request.time
        && (resource == null || resource.data.last < request.time - duration.value(10, 's'));
    }

    match /analytics_events/{id} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && validMissionStats(request.resource.data)
        && getAfter(/databases/$(database)/documents/analytics_limits/$(request.auth.uid)).data.last == request.time;
    }
  }
}
