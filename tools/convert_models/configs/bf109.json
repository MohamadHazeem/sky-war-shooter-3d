{
 "name": "bf109",
 "_comment": "Input is bf109/Models/bf109g14.ac itself, so config coords are the FlightGear coords of that .ac (x aft, y right, z up, metres). Bf-109g.xml shifts the whole model by x +1.639 with a top-level <offsets>, which convert_ac.py would apply to the main .ac only; loading the .ac plus the sub-models as extra_models (same offsets as in Bf-109g.xml) keeps them aligned. The gear is modelled retracted (Bf-109g.xml gear animations are 0 deg at position-norm 0); the main wheels stay visible in the open wells, as on the real aircraft.",
 "submodels": {"include": ["^$"], "exclude": []},
 "extra_models": [
  {"path": "Models/vdmprop.xml", "label": "pdisk", "offsets": {"x-m": -4.2, "y-m": 0.0, "z-m": 0.04185}},
  {"path": "Models/cockpit.xml", "label": "cockpit"},
  {"_comment": "Bf-109g.xml seats FlightGear's generic pilot (Aircraft/Generic/Human, base package) here; the package's own German flight suit + headgear are used instead and posed below",
   "path": "Models/germanpilot-m.xml", "label": "pilot", "offsets": {"x-m": -0.8, "y-m": 0.0, "z-m": -0.05}},
  {"path": "Models/germanheadgear-m.xml", "label": "headgear", "offsets": {"x-m": -0.8, "y-m": 0.0, "z-m": -0.05}}
 ],
 "exclude_objects": [
  "main/tropfilter.*",
  "pdisk/(fpdisk|spdisk|Prop[123]bend)",
  "cockpit/(intcockpitframe_G|grips)"
 ],
 "texture_files": {},
 "max_texture": 1024,
 "texture_max": {"cockpit.png": 512, "interiour.png": 512, "pilotsuit-ger.png": 512, "headgear-ger.png": 256},
 "decimate": {"headgear/hose": 0.3, "pilot/(boot|suitarm[12]|suitleg[12])\\..*": 0.5},
 "rotations": [
  {"_comment": "seated pose for the T-posed flight suit, in the pilot instance frame, inner joints first: knees, hips, then shoulders (down, then forward)",
   "instance": "pilot", "objects": ["pilot/(suitleg2|boot2?)\\.L"], "center": [0.03, -0.1, -0.4], "axis": [0, 1, 0], "angle": -15},
  {"instance": "pilot", "objects": ["pilot/(suitleg2|boot2?)\\.R"], "center": [0.03, 0.1, -0.4], "axis": [0, 1, 0], "angle": -15},
  {"instance": "pilot", "objects": ["pilot/(suitleg[12]|boot2?)\\.[LR]"], "center": [0.0, 0.0, -0.02], "axis": [0, 1, 0], "angle": 88},
  {"instance": "pilot", "objects": ["pilot/suitarm[12]\\.L"], "center": [0.05, -0.15, 0.49], "axis": [1, 0, 0], "angle": 75},
  {"instance": "pilot", "objects": ["pilot/suitarm[12]\\.R"], "center": [0.05, 0.15, 0.49], "axis": [1, 0, 0], "angle": -75},
  {"instance": "pilot", "objects": ["pilot/suitarm[12]\\.[LR]"], "center": [0.05, 0.0, 0.49], "axis": [0, 1, 0], "angle": 45}
 ],
 "nodes": [
  {"name": "prop_1", "objects": ["pdisk/Prop[123]", "main/prophub"], "axis": [[-3.2, 0.0, 0.04185], [-4.2, 0.0, 0.04185]]}
 ],
 "groups": [
  {"name": "glass", "objects": ["main/canopyglass_G10", "main/frontglass"]},
  {"name": "pilot", "objects": ["pilot/.*", "headgear/.*"]},
  {"name": "interior", "objects": ["cockpit/.*"]}
 ],
 "markers": {
  "eye_pilot": [-0.85, 0.0, 0.65],
  "muzzle_cowl_left": [-2.6, -0.2, 0.6],
  "muzzle_cowl_right": [-2.6, 0.2, 0.6],
  "muzzle_hub": [-4.6, 0.0, 0.07]
 },
 "origin": {"auto": {"wing": ["main/wing\\.[LR]"], "fuselage": ["main/fuselage_G"], "station": 0.6, "chord_frac": 0.27}},
 "materials": {"roughness": 0.68, "metallic": 0.1},
 "preview_shots": [
  {"name": "tail", "eye": [7.5, -2.5, 1.5], "target": [3.0, 0, 0.6], "lens": 35},
  {"name": "cockpit", "eye": [-2.4, -1.4, 1.4], "target": [-0.7, 0, 0.45], "lens": 30},
  {"name": "under", "eye": [-1.0, -3.0, -2.5], "target": [-1.9, -1.0, -0.3], "lens": 30}
 ]
}
